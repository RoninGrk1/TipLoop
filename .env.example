NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for auth, profiles, ledger)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live payments stay OFF until every flag and secret below is present.
PAYMENTS_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_CALLBACK_URL=https://YOUR_DOMAIN/api/webhooks/nowpayments

# Optional second provider
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# Cron for invoice expiry
CRON_SECRET=

# Observability
SENTRY_DSN=
